# Copy to `.env` and adjust for your machine. Never commit the real `.env`.
# `python -m app.cli init-env` creates `.env` from this file with a fresh JWT secret.
NIDHISEC_ENVIRONMENT=development
NIDHISEC_DATABASE_URL=sqlite:///./data/nidhisec.db
# Comma-separated list of allowed frontend origins (Vite dev server by default)
NIDHISEC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Access-token signing key: at least 32 random characters, unique per deployment.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NIDHISEC_JWT_SECRET=
NIDHISEC_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Private storage for uploaded FDR documents (outside any public folder) and upload size limit.
NIDHISEC_DOCUMENT_STORAGE_DIR=./storage/documents
NIDHISEC_MAX_UPLOAD_BYTES=10485760

# Lifecycle prototype rules (not official AICTE policy). Dates use Indian Standard Time.
NIDHISEC_MATURITY_ALERT_DAYS=30,15,7
NIDHISEC_AICTE_MATURITY_ALERT_DAYS=7
NIDHISEC_RENEWAL_WINDOW_DAYS=90
NIDHISEC_RELEASE_REQUIRES_MATURITY=true
NIDHISEC_LIFECYCLE_REQUIRE_SUCCESSOR_ACCEPTANCE=true
